<Window x:Class="CFSNetworkLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CFS Network Launcher"
        Icon="/CFSNetworkLauncher;component/Assets/9462bc4b-a3f4-4fc9-8d15-a8416816ca90.ico"
        Width="900"
        Height="560"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="#0B0F17"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Border CornerRadius="18"
            BorderThickness="1"
            BorderBrush="#273044"
            Background="#0B0F17">
        <Grid>

            <Grid.RowDefinitions>
                <RowDefinition Height="56"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="76"/>
            </Grid.RowDefinitions>

            <!-- TOP BAR -->
            <Grid Grid.Row="0" Background="#101725">
                <TextBlock Text="CFS NETWORK"
                           Foreground="White"
                           FontSize="19"
                           FontWeight="Bold"
                           VerticalAlignment="Center"
                           Margin="22,0,0,0"/>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="0,0,12,0">
                    <Button x:Name="MinimizeButton"
                            Content="—"
                            Click="Minimize_Click"
                            Width="42"
                            Height="34"
                            Margin="0,0,6,0"
                            Background="#182133"
                            Foreground="White"
                            BorderThickness="0"
                            FontSize="18"
                            Cursor="Hand"/>

                    <Button x:Name="CloseButton"
                            Content="✕"
                            Click="Close_Click"
                            Width="42"
                            Height="34"
                            Background="#7D2530"
                            Foreground="White"
                            BorderThickness="0"
                            FontSize="15"
                            Cursor="Hand"/>
                </StackPanel>
            </Grid>

            <!-- CONTENT -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2.1*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT -->
                <Grid Grid.Column="0" Margin="28,24,14,20">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            CornerRadius="14"
                            Background="#111827"
                            BorderBrush="#273044"
                            BorderThickness="1"
                            Padding="22">

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="CFS NETWORK"
                                       Foreground="#62A8FF"
                                       FontSize="14"
                                       FontWeight="Bold"/>

                            <TextBlock Grid.Row="1"
                                       Text="FiveM Roleplay"
                                       Foreground="White"
                                       FontSize="36"
                                       FontWeight="Bold"
                                       Margin="0,8,0,0"/>

                            <TextBlock Grid.Row="2"
                                       Text="Csatlakozz a szerverhez a hivatalos launcherből."
                                       Foreground="#A8B2C5"
                                       FontSize="15"
                                       Margin="0,8,0,0"/>

                            <StackPanel Grid.Row="3"
                                        VerticalAlignment="Bottom">

                                <TextBlock Text="SZERVER"
                                           Foreground="#68758B"
                                           FontSize="11"
                                           FontWeight="Bold"/>

                                <TextBlock x:Name="AddressText"
                                           Text="87.229.6.49:30120"
                                           Foreground="White"
                                           FontSize="17"
                                           Margin="0,5,0,16"/>

                                <Button x:Name="ConnectButton"
                                        Content="CSATLAKOZÁS"
                                        Click="Connect_Click"
                                        Height="54"
                                        Background="#246BCE"
                                        Foreground="White"
                                        BorderThickness="0"
                                        FontSize="16"
                                        FontWeight="Bold"
                                        Cursor="Hand"/>

                            </StackPanel>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Row="1"
                                Orientation="Horizontal"
                                Margin="2,14,0,0">
                        <Ellipse x:Name="StatusDot"
                                 Width="12"
                                 Height="12"
                                 Fill="#E6414B"
                                 VerticalAlignment="Center"/>

                        <TextBlock x:Name="StatusText"
                                   Text="ELLENŐRZÉS..."
                                   Foreground="#A8B2C5"
                                   FontSize="13"
                                   Margin="8,0,0,0"
                                   VerticalAlignment="Center"/>

                        <TextBlock x:Name="PlayersText"
                                   Text=""
                                   Foreground="#68758B"
                                   FontSize="13"
                                   Margin="14,0,0,0"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <!-- RIGHT -->
                <Grid Grid.Column="1" Margin="14,24,28,20">
                    <Border CornerRadius="14"
                            Background="#111827"
                            BorderBrush="#273044"
                            BorderThickness="1"
                            Padding="20">

                        <StackPanel>
                            <TextBlock Text="CFS NETWORK"
                                       Foreground="White"
                                       FontSize="21"
                                       FontWeight="Bold"/>

                            <TextBlock Text="Hivatalos launcher"
                                       Foreground="#68758B"
                                       FontSize="13"
                                       Margin="0,3,0,20"/>

                            <Border Height="120"
                                    CornerRadius="10"
                                    Background="#182133">
                                <TextBlock Text="CFS"
                                           Foreground="#62A8FF"
                                           FontSize="52"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>

                            <TextBlock Text="Szerver"
                                       Foreground="#68758B"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Margin="0,20,0,4"/>

                            <TextBlock Text="CFS Network"
                                       Foreground="White"
                                       FontSize="15"/>

                            <Button Content="DISCORD"
                                    Click="Discord_Click"
                                    Height="42"
                                    Margin="0,22,0,0"
                                    Background="#5865F2"
                                    Foreground="White"
                                    BorderThickness="0"
                                    FontWeight="Bold"
                                    Cursor="Hand"/>

                            <Button Content="FRISSÍTÉS"
                                    Click="Refresh_Click"
                                    Height="42"
                                    Margin="0,8,0,0"
                                    Background="#182133"
                                    Foreground="White"
                                    BorderThickness="0"
                                    Cursor="Hand"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <!-- BOTTOM -->
            <Grid Grid.Row="2" Background="#101725">
                <TextBlock Text="CFS Network • Hivatalos Launcher"
                           Foreground="#68758B"
                           VerticalAlignment="Center"
                           Margin="24,0,0,0"/>

                <TextBlock Text="v1.4.0"
                           Foreground="#68758B"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           Margin="0,0,24,0"/>
            </Grid>

        </Grid>
    </Border>
</Window>
